{
  "name": "synlexa-studio",
  "version": "0.4.0",
  "description": "Synlexa Studio desktop/browser launcher, MCP server (stdio & HTTP), and deterministic computational biology engine (Research-Use-Only).",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/Synlexa/synlexa-studio.git"
  },
  "homepage": "https://www.synlexa.com/download",
  "type": "module",
  "bin": {
    "synlexa-studio": "./bin/synlexa-studio.mjs"
  },
  "files": [
    "bin/",
    "scripts/",
    "wasm/",
    "web-dist/",
    "README.md",
    "LICENSE",
    "NOTICE"
  ],
  "scripts": {
    "postinstall": "node ./scripts/postinstall.mjs"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "optionalDependencies": {
    "@synlexa/studio-darwin-arm64": "0.4.0",
    "@synlexa/studio-darwin-x64": "0.4.0",
    "@synlexa/studio-linux-x64-gnu": "0.4.0",
    "@synlexa/studio-linux-arm64-gnu": "0.4.0",
    "@synlexa/studio-win32-x64-msvc": "0.4.0",
    "@synlexa/studio-win32-arm64-msvc": "0.4.0"
  },
  "keywords": [
    "synlexa",
    "bioinformatics",
    "structural-biology",
    "mcp",
    "webassembly",
    "crispr",
    "cheminformatics"
  ]
}
