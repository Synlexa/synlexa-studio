FROM nvidia/cuda:12.4.1-runtime-ubuntu22.04

ENV DEBIAN_FRONTEND=noninteractive \
    PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1

RUN apt-get update && apt-get install -y --no-install-recommends \
    python3 python3-pip python3-venv curl ca-certificates git && \
    rm -rf /var/lib/apt/lists/*

WORKDIR /opt/synlexa-compute
COPY pyproject.toml README.md ./
COPY synlexa_compute ./synlexa_compute

RUN pip3 install --upgrade pip && \
    pip3 install ".[server,chemistry,simulation,ai]"

EXPOSE 4180
ENTRYPOINT ["python3", "-m", "synlexa_compute.server", "--host", "0.0.0.0", "--port", "4180"]
