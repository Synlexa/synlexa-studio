{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://synlexa.com/schemas/synlexa-plugin.v1.schema.json",
  "title": "SynlexaPluginManifestV1",
  "type": "object",
  "required": [
    "schemaVersion",
    "id",
    "name",
    "version",
    "category",
    "tier",
    "license",
    "commercialSafe",
    "ruoRequired",
    "description"
  ],
  "properties": {
    "schemaVersion": { "const": "1.0.0" },
    "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9.-]{2,64}$" },
    "name": { "type": "string", "minLength": 2, "maxLength": 80 },
    "version": { "type": "string", "minLength": 1, "maxLength": 32 },
    "category": {
      "type": "string",
      "enum": [
        "Molecular visualization",
        "Molecular modeling",
        "Protein structure prediction",
        "Protein design",
        "Molecular docking",
        "Molecular dynamics",
        "Quantum chemistry",
        "Genomics",
        "Structural bioinformatics",
        "Cheminformatics ML",
        "Drug discovery workflows",
        "Scientific workflow orchestration",
        "Public databases"
      ]
    },
    "tier": {
      "type": "string",
      "enum": ["tier0-core", "tier1-wasm", "tier2-compute", "database"]
    },
    "license": { "type": "string", "minLength": 2 },
    "commercialSafe": { "type": "boolean" },
    "ruoRequired": { "const": true },
    "topPick": { "type": "boolean" },
    "description": { "type": "string", "minLength": 4, "maxLength": 400 },
    "homepage": { "type": "string", "format": "uri" },
    "computeAdapterId": { "type": "string" },
    "requiresGpu": { "type": "boolean" },
    "installHint": { "type": "string" },
    "mcpTools": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name", "description", "inputSchema"],
        "properties": {
          "name": { "type": "string", "pattern": "^[a-z][a-z0-9_]{2,64}$" },
          "description": { "type": "string" },
          "computeToolId": { "type": "string" },
          "inputSchema": { "type": "object" }
        }
      }
    }
  }
}
